# ---------------------------------------------------------------------------
# LLM provider (pick one). With none configured the system runs in "offline"
# mode: the same pipeline with deterministic, policy-grounded rule-based agents.
# Force a mode with LLM_MODE=azure|openai|offline
# ---------------------------------------------------------------------------
LLM_MODE=

# Azure AI Foundry / Azure OpenAI
AZURE_TEXTGENERATOR_DEPLOYMENT_NAME=
AZURE_TEXTGENERATOR_DEPLOYMENT_ENDPOINT=
AZURE_TEXTGENERATOR_DEPLOYMENT_KEY=
AZURE_API_VERSION=
AZURE_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI (used when Azure is not configured)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: OpenAI-compatible endpoint, e.g. NVIDIA NIM https://integrate.api.nvidia.com/v1
OPENAI_BASE_URL=

# Azure SQL Database (optional; falls back to sample customer data). Requires: pip install pyodbc
AZURE_SQL_CONNECTION_STRING=

# API
CORS_ORIGINS=*

# Optional generation settings (openai mode)
LLM_MAX_TOKENS=
LLM_TEMPERATURE=
LLM_REASONING_EFFORT=
